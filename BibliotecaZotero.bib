@article{davisIslandwideCharacterizationAgricultural2024,
  title = {Island-Wide Characterization of Agricultural Production Challenges the Demographic Collapse Hypothesis for {{Rapa Nui}} ({{Easter Island}})},
  author = {Davis, Dylan S. and DiNapoli, Robert J. and Pakarati, Gina and Hunt, Terry L. and Lipo, Carl P.},
  date = {2024-06-21},
  journaltitle = {Science Advances},
